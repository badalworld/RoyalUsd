# Royal USD — safe defaults; live execution is disabled until explicit server-side checks pass.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=
SQLITE_PATH=./data/royalusd.sqlite

# MEXC Futures API credentials belong only on the server. Do not grant withdrawals.
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_REST_URL=https://api.mexc.com
MEXC_WS_URL=wss://contract.mexc.com/edge
# Optional: keys entered on the Settings page are encrypted with this passphrase before being saved.
# Without it, Settings-page keys live only in server memory until restart.
CREDENTIAL_ENCRYPTION_KEY=

# Scanner universe: active, API-enabled USDT-margined perpetuals are auto-ranked by 24h range.
# The cap is for scanned/subscribed assets (not the separate 10-position trading limit).
AUTO_DISCOVER_HIGH_VOLATILITY=true
MAX_SCANNER_ASSETS=100
MIN_DAILY_RANGE_PCT=2
# Used only when automatic discovery is disabled.
SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT,XRP_USDT,DOGE_USDT

# Strategy defaults: completed one-minute candles; KDJ 9/3/3, EMA 9/21, ATR 14.
KDJ_LENGTH=9
KDJ_SMOOTHING_K=3
KDJ_SMOOTHING_D=3
EMA_FAST=9
EMA_SLOW=21
ATR_LENGTH=14
KDJ_LONG_MAX=30
KDJ_SHORT_MIN=70
STOP_ATR_MULTIPLE=1
TAKE_PROFIT_R=1.5
MAX_HOLDING_CANDLES=15
EMA_CROSS_COOLDOWN_CANDLES=3
MAX_CANDLE_RANGE_ATR=2.5
MAX_SPREAD_RATE=0.001
MIN_DEPTH_LIQUIDITY_USD=5000

# Risk defaults: caps intersect; configured per-trade risk never overrides portfolio/daily/margin limits.
PAPER_INITIAL_EQUITY=10000
RISK_PER_TRADE=0.08
AGGREGATE_PORTFOLIO_RISK_LIMIT=0.20
DAILY_MAX_LOSS=0.50
MAX_OPEN_POSITIONS=10
MAX_LEVERAGE=10
MAX_MARGIN_UTILIZATION=0.50
COMPOUNDING_ENABLED=true
MAX_CONSECUTIVE_LOSSES=3
ACCOUNT_TIMEZONE=UTC
TAKER_FEE_RATE=0.0008
MAKER_FEE_RATE=0.0006
SLIPPAGE_RATE=0.0005

# Live remains disabled by default. These flags are operator attestations, not automatic tests.
ALLOW_LIVE_TRADING=false
MEXC_LIVE_API_PERMISSION_VERIFIED=false
MEXC_LIVE_FEES_VERIFIED=false
MEXC_PROTECTIVE_ORDERS_TESTED=false
BACKTEST_ACCEPTED=false
PAPER_ACCEPTANCE_PASSED=false
RECOVERY_TEST_PASSED=false

# Use a long random token in production; it is not needed for local development.
DASHBOARD_API_TOKEN=
